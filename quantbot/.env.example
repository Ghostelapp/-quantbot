# ===================================================
# QuantBot Studio - Environment Configuration
# ===================================================

# Binance Futures API Credentials
# W przypadku braku kluczy silnik automatycznie uruchamia się w trybie HIGH-FIDELITY PAPER TRADING
BINANCE_API_KEY=twoj_klucz_api_binance
BINANCE_API_SECRET=twoj_sekret_api_binance

# Wybór środowiska: true = Binance Futures Testnet, false = Binance Futures Mainnet
BINANCE_TESTNET=true

# Rynki i pary handlowe (rozdzielane przecinkami)
TRADING_SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
LEVERAGE=5
MARGIN_MODE=isolated

# Parametry Strategii (EMA Crossover + Filtr RSI)
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50
RSI_PERIOD=14
RSI_LONG_LOWER=50.0
RSI_LONG_UPPER=70.0
RSI_SHORT_UPPER=50.0
RSI_SHORT_LOWER=30.0

# Ścisłe Zarządzanie Ryzykiem (Risk Management)
# Maksymalny procent salda ryzykowny na pojedynczą pozycję (1.5%)
RISK_PER_TRADE_PCT=1.5

# Odległość Stop-Loss w % od ceny wejścia
STOP_LOSS_PCT=1.5

# Odległość Take-Profit w % od ceny wejścia (RRR 1:2)
TAKE_PROFIT_PCT=3.0
RRR=2.0

# Aktywacja Break-Even po osiągnięciu zysku w %
TRAILING_BREAK_EVEN_PCT=1.5

# Circuit Breaker: Maksymalny dopuszczalny dzienny spadek kapitału (Max Drawdown)
CIRCUIT_BREAKER_MAX_DD_PCT=5.0

# Maksymalna liczba równocześnie otwartych pozycji
MAX_OPEN_POSITIONS=2

# Interwał odpytywania rynku (sekundy)
POLL_INTERVAL_SECONDS=15

# Ścieżka do bazy danych i poziom logowania
DATABASE_PATH=quantbot.db
LOG_LEVEL=INFO
